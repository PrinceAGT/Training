table 50100 "Inventory Adjustment Header"
{
    DataClassification = ToBeClassified;

    fields
    {
        field(1; "Adjustment No."; Code[20]) { }
        field(2; "Location Code"; Code[20]) { }
        field(3; "Request Date"; Date) { }
        field(4; "Requested By"; Code[50]) { }
        field(5; "Status"; Option Open, "Pending Approval", Approved, Posted) { }
        field(6; "Approved By"; Code[50]) { }
        field(7; "Posting Date"; Date) { }
    }

    keys
    {
        key(PK; "Adjustment No.") { Clustered = true; }
    }

    procedure HasLines(): Boolean
    var
        Line: Record "Inventory Adjustment Line";
    begin
        Line.SetRange("Adjustment No.", "Adjustment No.");
        exit(Line.FindFirst());
    end;
}

table 50101 "Inventory Adjustment Line"
{
    DataClassification = ToBeClassified;

    fields
    {
        field(1; "Adjustment No."; Code[20]) { }
        field(2; "Line No."; Integer) { }
        field(3; "Item No."; Code[20]) { }
        field(4; Description; Text[100]) { }
        field(5; Quantity; Decimal)
        {
            trigger OnValidate()
            begin
                if Quantity = 0 then
                    Error('Quantity cannot be zero.');
                CalcTotalCost();
            end;
        }
        field(6; "Unit Cost"; Decimal)
        {
            trigger OnValidate()
            begin
                CalcTotalCost();
            end;
        }
        field(7; "Total Cost"; Decimal) { Editable = false; }
    }

    keys
    {
        key(PK; "Adjustment No.", "Line No.") { Clustered = true; }
    }

    procedure CalcTotalCost()
    begin
        "Total Cost" := Quantity * "Unit Cost";
    end;
}

table 50102 "Adjustment Audit Log"
{
    DataClassification = ToBeClassified;

    fields
    {
        field(1; "Entry No."; Integer) { AutoIncrement = true; }
        field(2; "Adjustment No."; Code[20]) { }
        field(3; "Action Type"; Text[50]) { }
        field(4; "User ID"; Code[50]) { }
        field(5; "Action Date Time"; DateTime) { }
    }

    keys
    {
        key(PK; "Entry No.") { Clustered = true; }
    }
}

