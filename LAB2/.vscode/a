codeunit 50120 "Approval Management"
{
    procedure SendForApproval(var Header: Record "Inventory Adjustment Header")
    begin
        OnBeforeApproval(Header);
        Header.Status := Header.Status::"Pending Approval";
        Header.Modify();
        OnAfterApproval(Header);
    end;

    procedure ApproveDocument(var Header: Record "Inventory Adjustment Header")
    begin
        if not Header.HasLines() then
            Error('Cannot approve without lines.');

        Header.Status := Header.Status::Approved;
        Header."Approved By" := UserId();
        Header.Modify();
    end;

    [IntegrationEvent(false, false)]
    local procedure OnBeforeApproval(var Header: Record "Inventory Adjustment Header");
    begin
    end;

    [IntegrationEvent(false, false)]
    local procedure OnAfterApproval(var Header: Record "Inventory Adjustment Header");
    begin
    end;
}

codeunit 50121 "Posting Management"
{
    procedure ValidateBeforePosting(var Header: Record "Inventory Adjustment Header")
    begin
        if Header.Status <> Header.Status::Approved then
            Error('Document must be approved before posting.');
        if not Header.HasLines() then
            Error('Cannot post without lines.');
    end;

    procedure PostAdjustment(var Header: Record "Inventory Adjustment Header")
    begin
        OnBeforePosting(Header);
        ValidateBeforePosting(Header);

        if Header.Status = Header.Status::Posted then
            Error('Document already posted.');

        Header.Status := Header.Status::Posted;
        Header."Posting Date" := Today();
        Header.Modify();

        OnAfterPosting(Header);
    end;

    procedure CalculateTotalQuantity(var Lines: Record "Inventory Adjustment Line"): Decimal
    var
        Total: Decimal;
    begin
        Lines.Reset();
        if Lines.FindSet() then
            repeat
                Total += Lines.Quantity;
            until Lines.Next() = 0;
        exit(Total);
    end;

    [IntegrationEvent(false, false)]
    local procedure OnBeforePosting(var Header: Record "Inventory Adjustment Header");
    begin
    end;

    [IntegrationEvent(false, false)]
    local procedure OnAfterPosting(var Header: Record "Inventory Adjustment Header");
    begin
    end;
}

codeunit 50122 "Adjustment Event Subscribers"
{
    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Approval Management", 'OnBeforeApproval', '', false, false)]
    local procedure LogBeforeApproval(var Header: Record "Inventory Adjustment Header")
    var
        Log: Record "Adjustment Audit Log";
    begin
        Log.Init();
        Log."Adjustment No." := Header."Adjustment No.";
        Log."Action Type" := 'Before Approval';
        Log."User ID" := UserId();
        Log."Action Date Time" := CurrentDateTime();
        Log.Insert();
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Posting Management", 'OnAfterPosting', '', false, false)]
    local procedure LogAfterPosting(var Header: Record "Inventory Adjustment Header")
    var
        Log: Record "Adjustment Audit Log";
    begin
        Log.Init();
        Log."Adjustment No." := Header."Adjustment No.";
        Log."Action Type" := 'After Posting';
        Log."User ID" := UserId();
        Log."Action Date Time" := CurrentDateTime();
        Log.Insert();
        Message('Adjustment %1 has been successfully posted.', Header."Adjustment No.");
    end;
}
